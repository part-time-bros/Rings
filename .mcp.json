{
  "mcpServers": {
    "tradingview": {
      "command": "uvx",
      "args": ["--from", "tradingview-mcp-server", "tradingview-mcp"],
      "env": {
        "MARKETAUX_API_TOKEN": "${MARKETAUX_API_TOKEN:-}"
      }
    },
    "india-signals": {
      "command": "uv",
      "args": ["run", "--directory", ".", "india-signals-mcp"]
    }
  }
}
